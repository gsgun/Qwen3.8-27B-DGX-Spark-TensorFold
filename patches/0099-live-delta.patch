+class PoolGate(MemoryGate):
+    """A pinned pool: ``fits`` asks whether what torch holds beyond ``base`` (the weights and fixed buffers at the time the
+    pool was taken) plus ``extra`` stays within ``pool``. The pool is already ours, so the host's free memory is not asked."""
+
+    def __init__(self, pool: int, base: int, torch) -> None:
+        super().__init__(pool, 0, None)
+        self.base, self.torch = int(base), torch
+
+    def used(self) -> int:
+        return max(0, int(self.torch.cuda.memory_allocated()) - self.base)
+
+    def fits(self, extra: int) -> bool:
+        return self.used() + int(extra) <= self.room
+
+
