--- /dev/null
+++ tensorfold/cuda/kv_fp8.py
@@ -0,0 +1,61 @@
+"""An FP8 (e4m3) attention cache for the dense Qwen3.8-27B CUDA engine (opt-in).
+
+``TENSORFOLD_KV_DTYPE=fp8`` stores each layer's keys and values as float8_e4m3fn, one byte a value (half of bf16), with
+no scale: saturated at +-448 and rounded to nearest. The rows a forward attends to are rounded the same way before
+they are used (``round``), so a key reads alike whether it is still in a draft window or already committed, and a
+drafted reply still equals the serial one. Unset, nothing here changes anything.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+LIMIT = 448.0                      # e4m3fn's largest finite value
+
+
+def enabled() -> bool:
+    value = os.environ.get("TENSORFOLD_KV_DTYPE", "").strip().lower()
+    if value in ("", "bf16"):
+        return False
+    if value in ("fp8", "fp8_e4m3", "e4m3"):
+        return True
+    raise ValueError(f"TENSORFOLD_KV_DTYPE: bf16 or fp8, not {value!r}")
+
+
+def dtype() -> torch.dtype:
+    return torch.float8_e4m3fn if enabled() else torch.bfloat16
+
+
+def itemsize() -> int:
+    return 1 if enabled() else 2
+
+
+def round(x: torch.Tensor) -> torch.Tensor:
+    """``x`` (bf16) as the cache will hold it: through e4m3, saturating. A no-op for a bf16 cache."""
+
+    if not enabled():
+        return x
+    return x.clamp(-LIMIT, LIMIT).to(torch.float8_e4m3fn).to(torch.bfloat16)
+
+
+def dense(cache: torch.Tensor, rows: int) -> torch.Tensor:
+    """The cache's first ``rows`` rows as bf16 (the prompt-attention kernel reads bf16): exact, e4m3 fits bf16."""
+
+    return cache[:rows] if cache.dtype == torch.bfloat16 else cache[:rows].to(torch.bfloat16)
+
+
+def pool_bytes() -> int:
+    """``TENSORFOLD_KV_POOL_GIB``: GiB of attention cache to pin for the concurrent streams at startup (0: grow on demand)."""
+
+    value = os.environ.get("TENSORFOLD_KV_POOL_GIB", "").strip()
+    if not value:
+        return 0
+    try:
+        gib = float(value)
+    except ValueError:
+        gib = float("nan")
+    if not gib >= 0:
+        raise ValueError(f"TENSORFOLD_KV_POOL_GIB={value}: a number of GiB, 0 or more")
+    return int(gib * 1024**3)
